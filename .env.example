# Local API
BROBOND_DATABASE_URL=sqlite:///./brobond.db
# PR002: must be at least 32 bytes (RFC 7518, HS256). The API refuses to boot
# with a shorter secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BROBOND_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes-0123456789-abcdefghijklmnopqrstuvwxyz
# Auth rate limit: attempts per client IP per minute on /auth/login and
# /auth/register. Set 0 to disable.
BROBOND_RATE_LIMIT_AUTH_PER_MINUTE=20
BROBOND_REDIS_URL=redis://localhost:6379/0
BROBOND_QUEUE_ENABLED=false
BROBOND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
BROBOND_STORAGE_ENABLED=false
BROBOND_MINIO_ENDPOINT=http://localhost:9000
BROBOND_MINIO_ACCESS_KEY=brobond
BROBOND_MINIO_SECRET_KEY=brobond_local_storage
BROBOND_MINIO_BUCKET=brobond-assets

# GPU providers
BROBOND_INFERENCE_ENABLED=false
BROBOND_TRAINING_ENABLED=false
BROBOND_WEIGHTS_DIR=weights
BROBOND_VIDEO_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
BROBOND_LORA_TRAINER_COMMAND=

# External GPU cluster (PR011) — all four are OPTIONAL in development.
# With them unset the API boots normally, `/api/v1/system/readiness` reports
# `gpu.available: false` with the reason, and renders fall back exactly as
# they do without a local GPU. The key never reaches the browser: it is used
# only by backend/app/providers/gpu_client.py.
BROBOND_RUNPOD_API_KEY=
BROBOND_RUNPOD_ENDPOINT=
# Seconds to wait for one GPU job (0 disables the deadline).
BROBOND_GPU_TIMEOUT=300
# Seconds between job status polls. Polling is server-side only.
BROBOND_GPU_POLL_INTERVAL=2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
